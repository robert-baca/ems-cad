{
  "appId": "com.sfotems.crew",
  "appName": "Six Flags EMS",
  "webDir": "dist",
  "backgroundColor": "#111827",
  "server": {
    "androidScheme": "https",
    "url": "https://sfotems.com",
    "allowNavigation": ["*.sfotems.com", "localhost"],
    "errorPath": "fallback.html"
  },
  "plugins": {
    "Geolocation": {
      "permissions": ["location", "coarseLocation", "backgroundLocation"]
    }
  }
}
